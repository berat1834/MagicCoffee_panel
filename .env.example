# Boş bırakılırsa panel API'ye göreli yolla (aynı origin / nginx proxy) bağlanır.
VITE_API_URL=
# Yalnız geliştirme: vite dev sunucusunun /api proxy hedefi.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
# Yalnız geliştirme: 1 ise API yerine tarayıcı içi örnek veri kullanılır (üretim derlemesine girmez).
VITE_MOCK=0
